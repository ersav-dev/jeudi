# Supabase — copie ce fichier en .env.local et remplis tes valeurs.
# Settings → API dans le dashboard Supabase. La clé anon est publique (côté client),
# protégée par les règles RLS. NE JAMAIS mettre la clé service_role ici.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# push (0020) — genere la tienne : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=colle-ta-cle-publique-ici
